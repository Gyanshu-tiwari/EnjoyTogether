# ── EnjoyTogether Staging Environment Configuration ───────────────────────────
# Instructions:
# 1. Copy this template to backend/.env.staging:
#      cp backend/.env.staging.example backend/.env.staging
# 2. Fill in the placeholders below with credentials from your EnjoyTogether-Staging project.
# 3. Do NOT commit backend/.env.staging to version control.
# 4. Do NOT use production or local development database credentials here.

# Staging HTTP Server Configuration
PORT=5001
NODE_ENV=staging
CORS_ORIGIN=http://localhost:5173

# Staging Supabase Credentials (from EnjoyTogether-Staging Dashboard -> Project Settings -> API)
# Replace with your staging project URL and service_role secret key:
SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_staging_service_role_key_here

# Staging Direct PostgreSQL Connection String (from EnjoyTogether-Staging Dashboard -> Project Settings -> Database -> Connection string)
# Copy the exact connection string (URI format) from your staging Supabase project settings.
# Compatible with direct connection or transaction/session connection pooler.
# Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST]:[PORT]/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-staging-project-ref:your_staging_password@your-staging-host:6543/postgres?sslmode=require

# WebRTC SFU configurations (LiveKit staging or shared development instance)
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here
LIVEKIT_URL=wss://your-livekit-server-url_here
